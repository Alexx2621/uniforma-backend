# Para el detalle de la configuracion de produccion (cPanel), ver DESPLIEGUE-CPANEL.md

# En produccion DATABASE_URL debe conservar ?connection_limit=2 (tope de 20 conexiones del plan)
DATABASE_URL="mysql://root:password@localhost:3306/uniforma"
PORT=3000

STOCK_ALERT_THRESHOLD=5
HIGH_SALE_THRESHOLD=1000
NOTIF_EMAIL_TO=
NOTIF_WHATSAPP_TO=
REPORT_EMAIL_TO=

# Alertas programadas: token compartido con el cron que despierta la app en cPanel
ALERTAS_CRON_TOKEN=
# Poner en 'true' solo si se quiere desactivar el barrido interno cada 30s
ALERTAS_SCHEDULER_DISABLED=

# Render de PDF. Si esta vacio se usa el Chromium local (solo desarrollo);
# en cPanel es obligatorio porque el hosting no puede ejecutar Chromium.
PDF_RENDERER_URL=
PDF_RENDERER_TOKEN=

# Limite de hilos: obligatorio en cPanel, la cuenta tiene un tope de 100 procesos/hilos
UV_THREADPOOL_SIZE=2
TOKIO_WORKER_THREADS=2
RAYON_NUM_THREADS=2

# Resend
RESEND_ENABLED=true
RESEND_API_KEY=
RESEND_FROM="Uniforma <reportes@tu-dominio.com>"
RESEND_TEMPLATE_ID=

# SMTP fallback, optional if Resend is enabled
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM="Uniforma <noreply@tu-dominio.com>"
