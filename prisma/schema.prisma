model DocumentoGenerado {
  id            Int      @id @default(autoincrement())
  tipo          String
  correlativo   String   @unique
  titulo        String?
  data          Json
  usuarioId     Int
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  usuario      Usuario               @relation(fields: [usuarioId], references: [id])
  correcciones CorreccionDocumento[]

  @@index([tipo, creadoEn])
  @@index([usuarioId, creadoEn])
}

model DocumentoBorrador {
  id                  Int       @id @default(autoincrement())
  tipoDocumento       String
  estado              String    @default("abierto")
  titulo              String?
  data                Json
  totalEstimado       Float     @default(0)
  usuarioId           Int
  bodegaId            Int?
  clienteId           Int?
  documentoFinalTipo  String?
  documentoFinalId    Int?
  documentoFinalFolio String?
  bloqueadoPorId      Int?
  bloqueadoEn         DateTime?
  bloqueadoHasta      DateTime?
  creadoEn            DateTime  @default(now())
  actualizadoEn       DateTime  @updatedAt

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, tipoDocumento, estado, actualizadoEn])
  @@index([tipoDocumento, estado, actualizadoEn])
  @@index([documentoFinalTipo, documentoFinalId])
  @@index([bloqueadoPorId, bloqueadoHasta])
  @@index([bodegaId])
  @@index([clienteId])
  @@map("documentoborrador")
}

model CorreccionDocumento {
  id            Int      @id @default(autoincrement())
  documentoId   Int
  usuarioId     Int
  tipoDocumento String
  correlativo   String
  campo         String
  etiqueta      String
  valorAnterior Json?
  valorNuevo    Json?
  motivo        String   @db.MediumText
  dataAnterior  Json
  dataNueva     Json
  creadoEn      DateTime @default(now())

  documento DocumentoGenerado @relation(fields: [documentoId], references: [id])
  usuario   Usuario           @relation(fields: [usuarioId], references: [id])

  @@index([documentoId, creadoEn])
  @@index([usuarioId, creadoEn])
  @@index([tipoDocumento, creadoEn])
  @@index([correlativo])
}

model CorreccionControlada {
  id            Int      @id @default(autoincrement())
  modulo        String
  entidadTipo   String
  entidadId     Int
  correlativo   String?
  titulo        String?
  campo         String
  etiqueta      String
  valorAnterior Json?
  valorNuevo    Json?
  motivo        String   @db.MediumText
  dataAnterior  Json?
  dataNueva     Json?
  usuarioId     Int
  creadoEn      DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([entidadTipo, entidadId, creadoEn])
  @@index([usuarioId, creadoEn])
  @@index([modulo, creadoEn])
  @@index([correlativo])
}

model CambioDevolucion {
  id                  Int      @id @default(autoincrement())
  folio               String   @unique
  tipo                String
  fecha               DateTime @default(now())
  clienteNombre       String
  clienteTelefono     String?
  documentoReferencia String?
  motivo              String
  estado              String   @default("pendiente")
  resolucion          String?
  monto               Float    @default(0)
  observaciones       String?  @db.MediumText
  detalle             Json
  usuarioId           Int?
  creadoEn            DateTime @default(now())
  actualizadoEn       DateTime @updatedAt

  usuario Usuario?           @relation(fields: [usuarioId], references: [id])
  pedidos PedidoProduccion[]

  @@index([tipo, fecha])
  @@index([estado, fecha])
  @@index([usuarioId, fecha])
}

model WhatsappMensaje {
  id              Int      @id @default(autoincrement())
  vendedorId      Int
  numeroVendedor  String?
  phoneNumberId   String?
  remitente       String
  remitenteNombre String?
  mensaje         String?  @db.MediumText
  externalId      String?  @unique
  leido           Boolean  @default(false)
  recibidoEn      DateTime @default(now())
  creadoEn        DateTime @default(now())

  vendedor Usuario @relation(fields: [vendedorId], references: [id])

  @@index([vendedorId, leido, recibidoEn])
  @@index([recibidoEn])
}

model TelaRollo {
  id                 Int      @id @default(autoincrement())
  codigo             String   @unique
  telaId             Int
  colorId            Int?
  bodegaId           Int?
  proveedorId        Int?
  proveedor          String?
  lote               String?
  tono               String?
  ancho              Float    @default(0)
  unidad             String   @default("metros")
  cantidadInicial    Float    @default(0)
  cantidadDisponible Float    @default(0)
  costoUnitario      Float    @default(0)
  ubicacion          String?
  estado             String   @default("disponible")
  fechaIngreso       DateTime @default(now())
  observaciones      String?  @db.MediumText
  creadoEn           DateTime @default(now())
  actualizadoEn      DateTime @updatedAt

  tela                Tela                 @relation(fields: [telaId], references: [id])
  color               Color?               @relation(fields: [colorId], references: [id])
  bodega              Bodega?              @relation(fields: [bodegaId], references: [id])
  proveedorRef        Proveedor?           @relation(fields: [proveedorId], references: [id])
  movimientos         MovimientoTela[]
  ingresosTelaDetalle IngresoTelaDetalle[]

  @@index([telaId])
  @@index([colorId])
  @@index([bodegaId])
  @@index([proveedorId])
  @@index([estado])
}

model MovimientoTela {
  id            Int      @id @default(autoincrement())
  rolloId       Int
  tipo          String
  cantidad      Float
  fecha         DateTime @default(now())
  referencia    String?
  motivo        String?
  observaciones String?  @db.MediumText
  usuarioId     Int?
  creadoEn      DateTime @default(now())

  rollo TelaRollo @relation(fields: [rolloId], references: [id])

  @@index([rolloId, fecha])
  @@index([tipo, fecha])
}

model ConsumoTelaProducto {
  id              Int      @id @default(autoincrement())
  productoId      Int
  telaId          Int?
  tallaId         Int?
  cantidad        Float    @default(0)
  unidad          String   @default("metros")
  mermaPorcentaje Float    @default(0)
  observaciones   String?  @db.MediumText
  creadoEn        DateTime @default(now())
  actualizadoEn   DateTime @updatedAt

  producto Producto @relation(fields: [productoId], references: [id])
  tela     Tela?    @relation(fields: [telaId], references: [id])
  talla    Talla?   @relation(fields: [tallaId], references: [id])

  @@index([productoId])
  @@index([telaId])
  @@index([tallaId])
}

/**
 * ======================
 * CONFIGURACIÓN
 * ======================
 */

model NotificacionConfig {
  id                        Int     @id @default(1)
  emailTo                   String? @default("")
  whatsappTo                String? @default("")
  stockThreshold            Int     @default(5)
  highSaleThreshold         Int     @default(1000)
  disabledPaths             Json?
  productionInternalMode    Boolean @default(false)
  salesInventoryEnabled     Boolean @default(true)
  userDisabledPaths         Json?
  productMassConfig         Json?
  pedidoAlertRoleIds        Json?
  crossStoreRoleIds         Json?
  unifyOrderRoleIds         Json?
  vendedorDropdownRoleIds   Json?
  vendedorDropdownBodegaIds Json?

  // Configuración SMTP para correos
  smtpHost String? @default("smtp.gmail.com")
  smtpPort Int     @default(587)
  smtpUser String?
  smtpPass String?
  smtpFrom String? @default("noreply@uniforma.com")

  // Configuración de Resend para envío de correos
  resendEnabled    Boolean @default(false)
  resendApiKey     String?
  resendFrom       String? @default("noreply@uniforma.com")
  resendTemplateId String?

  // Configuración de reportes automáticos
  reportesConfig       Json? // Array de configuraciones de reportes
  sessionInvalidatedAt DateTime?

  updatedAt DateTime @updatedAt
}

/**
 * ======================
 * IMÁGENES
 * ======================
 */

model ImagenProducto {
  id          Int     @id @default(autoincrement())
  productoId  Int
  url         String
  descripcion String?
  esPrincipal Boolean @default(false)

  producto Producto @relation(fields: [productoId], references: [id])
}
