generator client {
  provider      = "prisma-client-js"
  // native = Windows (desarrollo); debian = el servidor de cPanel, que no
  // puede ejecutar prisma generate porque su motor de esquema es WebAssembly.
  binaryTargets = ["native", "debian-openssl-1.0.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/**
 * ======================
 * TABLAS GENERALES
 * ======================
 */

model Categoria {
  id          Int        @id @default(autoincrement())
  nombre      String
  descripcion String?
  productos   Producto[]
}

model Tela {
  id                  Int                   @id @default(autoincrement())
  nombre              String
  descripcion         String?
  productos           Producto[]
  rollosTela          TelaRollo[]
  consumosTela        ConsumoTelaProducto[]
  aliasesProveedor    TelaProveedorAlias[]
  ingresosTelaDetalle IngresoTelaDetalle[]
}

model Color {
  id                   Int                   @id @default(autoincrement())
  nombre               String
  codigoHex            String?
  productos            Producto[]
  rollosTela           TelaRollo[]
  aliasesTelaProveedor TelaProveedorAlias[]
  aliasesProveedor     ColorProveedorAlias[]
  ingresosTelaDetalle  IngresoTelaDetalle[]
}

model Talla {
  id           Int                   @id @default(autoincrement())
  nombre       String
  productos    Producto[]
  consumosTela ConsumoTelaProducto[]
}

/**
 * ======================
 * PRODUCTOS
 * ======================
 */

model Producto {
  id              Int     @id @default(autoincrement())
  codigo          String  @unique
  nombre          String
  genero          String?
  tipo            String?
  precio          Float
  mermaPorcentaje Float   @default(0)
  stockMax        Int     @default(0)

  categoriaId Int?
  telaId      Int?
  colorId     Int?
  tallaId     Int?

  categoria Categoria? @relation(fields: [categoriaId], references: [id])
  tela      Tela?      @relation(fields: [telaId], references: [id])
  color     Color?     @relation(fields: [colorId], references: [id])
  talla     Talla?     @relation(fields: [tallaId], references: [id])

  inventario               Inventario[]
  detalleVenta             DetalleVenta[]
  detalleIngreso           DetalleIngreso[]
  detallePedidoProduccion  DetallePedidoProduccion[]
  detalleTraslado          DetalleTraslado[]
  detalleSolicitudTraslado DetalleSolicitudTraslado[]
  detalleConteoInventario  DetalleConteoInventario[]
  ordenMixtaDetalle        OrdenMixtaDetalle[]
  stockMinimosBodega       StockMinimoBodegaProducto[]
  imagenes                 ImagenProducto[]
  consumoInsumos           ConsumoInsumo[]
  consumosTela             ConsumoTelaProducto[]
  costosProduccion         CostosProduccion[]
  movimientosInventario    MovInventario[]
}

/**
 * ======================
 * CLIENTES
 * ======================
 */

model Cliente {
  id          Int      @id @default(autoincrement())
  nombre      String
  telefono    String?
  correo      String?
  direccion   String?
  tipoCliente String?
  logoUrl     String?  @db.MediumText
  creadoEn    DateTime @default(now())
  usuarioId   Int?

  ventas        Venta[]
  pedidos       PedidoProduccion[]
  ordenesMixtas OrdenMixta[]
  usuario       Usuario?           @relation(fields: [usuarioId], references: [id])
  envios        Envio[]
  autorizacionesVenta AutorizacionVentaCliente[]

  @@index([usuarioId])
}

/**
 * ======================
 * VENTAS
 * ======================
 */

model Venta {
  id              Int      @id @default(autoincrement())
  folio           String?  @unique
  fecha           DateTime @default(now())
  clienteId       Int?
  clienteNombre   String?
  clienteTelefono String?
  total           Float    @default(0)
  metodoPago      String
  ubicacion       String?
  recargo         Float    @default(0)
  envio           Float    @default(0)
  observaciones   String?
  bodegaId        Int?
  vendedor        String?

  cliente             Cliente?            @relation(fields: [clienteId], references: [id])
  bodega              Bodega?             @relation(fields: [bodegaId], references: [id])
  detalle             DetalleVenta[]
  pagos               PagoVenta[]
  solicitudesTraslado SolicitudTraslado[]
  ordenesMixtas       OrdenMixta[]
  autorizacionCliente AutorizacionVentaCliente?
}

model AutorizacionVentaCliente {
  id Int @id @default(autoincrement())
  clienteId Int
  solicitanteId Int
  propietarioId Int
  ventaId Int? @unique
  modulo String @default("venta")
  operacionId Int?
  estado String @default("pendiente")
  motivo String? @db.MediumText
  respuesta String? @db.MediumText
  creadoEn DateTime @default(now())
  resueltoEn DateTime?
  consumidoEn DateTime?
  cliente Cliente @relation(fields: [clienteId], references: [id])
  solicitante Usuario @relation("AutorizacionClienteSolicitante", fields: [solicitanteId], references: [id])
  propietario Usuario @relation("AutorizacionClientePropietario", fields: [propietarioId], references: [id])
  venta Venta? @relation(fields: [ventaId], references: [id])
  @@index([solicitanteId, clienteId, modulo, estado], map: "AutorizacionVentaCliente_solicitante_cliente_modulo_estado_idx")
  @@index([propietarioId, estado, creadoEn])
}

model DetalleVenta {
  id                   Int       @id @default(autoincrement())
  ventaId              Int
  productoId           Int
  bodegaId             Int?
  cantidad             Int
  precioUnit           Float
  bordado              Float     @default(0)
  bordadoColor         String?
  bordadoTamano        String?
  bordadoPosicion      String?
  bordadoObservaciones String?   @db.MediumText
  bordadoImagenUrl     String?   @db.MediumText
  bordadoEstado        String?
  bordadoFechaEntrega  DateTime?
  descuento            Float     @default(0)
  descripcion          String?   @default("") @db.MediumText
  subtotal             Float
  requiereTraslado     Boolean   @default(false)
  trasladoEstado       String?
  solicitudTrasladoId  Int?

  venta             Venta                 @relation(fields: [ventaId], references: [id])
  producto          Producto              @relation(fields: [productoId], references: [id])
  bodegaOrigen      Bodega?               @relation("DetalleVentaBodegaOrigen", fields: [bodegaId], references: [id])
  solicitudTraslado SolicitudTraslado?    @relation(fields: [solicitudTrasladoId], references: [id])
  bordados          BordadoDetalleVenta[]

  @@index([bodegaId])
  @@index([requiereTraslado, trasladoEstado])
  @@index([solicitudTrasladoId])
}

model BordadoDetalleVenta {
  id            Int       @id @default(autoincrement())
  detalleId     Int
  monto         Float     @default(0)
  color         String?
  tamano        String?
  posicion      String?
  observaciones String?   @db.MediumText
  imagenUrl     String?   @db.MediumText
  estado        String?
  fechaEntrega  DateTime?
  creadoEn      DateTime  @default(now())
  actualizadoEn DateTime  @updatedAt

  detalle DetalleVenta @relation(fields: [detalleId], references: [id])

  @@index([detalleId])
  @@index([estado])
}

model PagoVenta {
  id         Int      @id @default(autoincrement())
  ventaId    Int
  metodo     String
  monto      Float
  referencia String?
  banco      String?
  fecha      DateTime @default(now())

  venta Venta @relation(fields: [ventaId], references: [id])
}

/**
 * ======================
 * INVENTARIOS
 * ======================
 */

model Bodega {
  id                       Int                         @id @default(autoincrement())
  nombre                   String
  ubicacion                String?
  tipo                     String                      @default("tienda")
  activa                   Boolean                     @default(true)
  permiteVentas            Boolean                     @default(true)
  usaInventarioVentas      Boolean                     @default(false)
  permitePedidos           Boolean                     @default(true)
  permiteTraslados         Boolean                     @default(true)
  visibleVendedores        Boolean                     @default(false)
  requiereAutorizacion     Boolean                     @default(false)
  // Bodega puente donde queda la mercaderia mientras viaja entre tiendas: sale
  // del origen al despachar y solo llega al destino cuando este confirma. Solo
  // una bodega puede tenerlo activo (lo garantiza BodegasService).
  esTransito               Boolean                     @default(false)
  // La bodega de transito no debe recibir mercaderia por el modulo de Ingresos:
  // lo que hay ahi tiene que haber entrado por un traslado.
  permiteIngresos          Boolean                     @default(true)
  ordenPrioridad           Int                         @default(100)
  observaciones            String?                     @db.MediumText
  inventario               Inventario[]
  ingresos                 IngresoInventario[]
  trasladosDesde           Traslado[]                  @relation("DesdeBodega")
  trasladosHacia           Traslado[]                  @relation("HaciaBodega")
  movimientos              MovInventario[]
  solicitudesTrasladoDesde SolicitudTraslado[]         @relation("SolicitudTrasladoDesdeBodega")
  solicitudesTrasladoHacia SolicitudTraslado[]         @relation("SolicitudTrasladoHaciaBodega")
  conteos                  ConteoInventario[]
  stockMinimos             StockMinimoBodegaProducto[]
  usuarios                 Usuario[]
  usuariosPermitidos       UsuarioBodega[]
  pedidos                  PedidoProduccion[]
  ventas                   Venta[]
  detalleVentasOrigen      DetalleVenta[]              @relation("DetalleVentaBodegaOrigen")
  correlativos             CorrelativoConfig[]
  unificadosProduccion     ProduccionUnificado[]
  metasMensuales           MetaMensual[]
  envios                   Envio[]
  rollosTela               TelaRollo[]
  ingresosTelaDetalle      IngresoTelaDetalle[]
  ordenesMixtas            OrdenMixta[]
  ordenMixtaDetalle        OrdenMixtaDetalle[]

  @@index([activa])
  @@index([tipo])
  @@index([ordenPrioridad])
}

model CorrelativoConfig {
  id              Int      @id @default(autoincrement())
  tipo            String
  scope           String   @unique
  nombre          String
  abreviatura     String
  siguienteNumero Int      @default(1)
  bodegaId        Int?
  activo          Boolean  @default(true)
  creadoEn        DateTime @default(now())
  actualizadoEn   DateTime @updatedAt

  bodega Bodega? @relation(fields: [bodegaId], references: [id])

  @@index([tipo])
  @@index([bodegaId])
}

model ProduccionUnificado {
  id             Int      @id @default(autoincrement())
  scope          String
  firmaContenido String
  correlativo    String   @unique
  abreviatura    String
  numero         Int
  nombre         String
  bodegaId       Int?
  resumen        Json?
  creadoEn       DateTime @default(now())
  actualizadoEn  DateTime @updatedAt

  bodega  Bodega?                     @relation(fields: [bodegaId], references: [id])
  pedidos ProduccionUnificadoPedido[]

  @@unique([scope, firmaContenido])
  @@index([scope, creadoEn])
  @@index([bodegaId])
}

model ProduccionUnificadoPedido {
  produccionUnificadoId Int
  pedidoId              Int
  creadoEn              DateTime @default(now())

  produccionUnificado ProduccionUnificado @relation(fields: [produccionUnificadoId], references: [id])
  pedido              PedidoProduccion    @relation(fields: [pedidoId], references: [id])

  @@id([produccionUnificadoId, pedidoId])
  @@index([pedidoId])
}

model Inventario {
  id         Int @id @default(autoincrement())
  bodegaId   Int
  productoId Int
  stock      Int @default(0)

  bodega   Bodega   @relation(fields: [bodegaId], references: [id])
  producto Producto @relation(fields: [productoId], references: [id])

  @@unique([bodegaId, productoId])
}

/**
 * ======================
 * INGRESOS A BODEGA
 * ======================
 */

model IngresoInventario {
  id            Int      @id @default(autoincrement())
  folio         String?  @unique
  requestId     String?  @unique
  fecha         DateTime @default(now())
  bodegaId      Int
  observaciones String?
  responsable   String?

  bodega  Bodega           @relation(fields: [bodegaId], references: [id])
  detalle DetalleIngreso[]
}

model DetalleIngreso {
  id         Int @id @default(autoincrement())
  ingresoId  Int
  productoId Int
  cantidad   Int

  ingreso  IngresoInventario @relation(fields: [ingresoId], references: [id])
  producto Producto          @relation(fields: [productoId], references: [id])
}

/**
 * ======================
 * TRASLADOS
 * ======================
 */

model Traslado {
  id                  Int      @id @default(autoincrement())
  folio               String?  @unique
  fecha               DateTime @default(now())
  desdeBodegaId       Int
  haciaBodegaId       Int
  observaciones       String?
  responsable         String?
  estado              String   @default("RECIBIDO")
  solicitudTrasladoId Int?

  desdeBodega       Bodega             @relation("DesdeBodega", fields: [desdeBodegaId], references: [id])
  haciaBodega       Bodega             @relation("HaciaBodega", fields: [haciaBodegaId], references: [id])
  solicitudTraslado SolicitudTraslado? @relation(fields: [solicitudTrasladoId], references: [id])

  detalle DetalleTraslado[]

  @@index([estado])
  @@index([solicitudTrasladoId])
}

model DetalleTraslado {
  id         Int @id @default(autoincrement())
  trasladoId Int
  productoId Int
  cantidad   Int

  traslado Traslado @relation(fields: [trasladoId], references: [id])
  producto Producto @relation(fields: [productoId], references: [id])
}

model SolicitudTraslado {
  id            Int       @id @default(autoincrement())
  folio         String?   @unique
  fecha         DateTime  @default(now())
  ventaId       Int?
  desdeBodegaId Int
  haciaBodegaId Int
  estado        String    @default("PENDIENTE")
  responsable   String?
  solicitanteId Int?
  observaciones String?   @db.MediumText
  aprobadoPor   String?
  aprobadoEn    DateTime?
  recibidoEn    DateTime?

  venta         Venta?                     @relation(fields: [ventaId], references: [id])
  desdeBodega   Bodega                     @relation("SolicitudTrasladoDesdeBodega", fields: [desdeBodegaId], references: [id])
  haciaBodega   Bodega                     @relation("SolicitudTrasladoHaciaBodega", fields: [haciaBodegaId], references: [id])
  solicitante   Usuario?                   @relation(fields: [solicitanteId], references: [id])
  detalle       DetalleSolicitudTraslado[]
  detallesVenta DetalleVenta[]
  traslados     Traslado[]

  @@index([ventaId])
  @@index([desdeBodegaId])
  @@index([haciaBodegaId])
  @@index([estado])
  @@index([solicitanteId])
}

model DetalleSolicitudTraslado {
  id               Int    @id @default(autoincrement())
  solicitudId      Int
  detalleVentaId   Int?
  productoId       Int
  cantidad         Int
  cantidadRecibida Int    @default(0)
  estado           String @default("PENDIENTE")

  solicitud SolicitudTraslado @relation(fields: [solicitudId], references: [id])
  producto  Producto          @relation(fields: [productoId], references: [id])

  @@index([solicitudId])
  @@index([productoId])
  @@index([detalleVentaId])
}

model ConteoInventario {
  id            Int      @id @default(autoincrement())
  folio         String?  @unique
  fecha         DateTime @default(now())
  bodegaId      Int
  responsable   String?
  observaciones String?  @db.MediumText
  estado        String   @default("APLICADO")

  bodega  Bodega                    @relation(fields: [bodegaId], references: [id])
  detalle DetalleConteoInventario[]

  @@index([bodegaId])
  @@index([fecha])
}

model DetalleConteoInventario {
  id           Int @id @default(autoincrement())
  conteoId     Int
  productoId   Int
  stockSistema Int
  stockFisico  Int
  diferencia   Int

  conteo   ConteoInventario @relation(fields: [conteoId], references: [id])
  producto Producto         @relation(fields: [productoId], references: [id])

  @@index([conteoId])
  @@index([productoId])
}

model StockMinimoBodegaProducto {
  id         Int @id @default(autoincrement())
  bodegaId   Int
  productoId Int
  minimo     Int @default(0)

  bodega   Bodega   @relation(fields: [bodegaId], references: [id])
  producto Producto @relation(fields: [productoId], references: [id])

  @@unique([bodegaId, productoId])
  @@index([productoId])
}

/**
 * ======================
 * INSUMOS
 * ======================
 */

model Insumo {
  id            Int    @id @default(autoincrement())
  nombre        String
  tipo          String
  unidad        String
  stock         Float  @default(0)
  stockMin      Float  @default(0)
  costoPromedio Float  @default(0)

  consumoProductos ConsumoInsumo[]
  mermas           MermaProduccion[]
  ordenesCompra    DetalleOrdenCompra[]
}

model ConsumoInsumo {
  id                Int   @id @default(autoincrement())
  productoId        Int
  insumoId          Int
  cantidadPorUnidad Float

  producto Producto @relation(fields: [productoId], references: [id])
  insumo   Insumo   @relation(fields: [insumoId], references: [id])
}

/**
 * ======================
 * PRODUCCIÓN
 * ======================
 */

model PedidoProduccion {
  id                   Int      @id @default(autoincrement())
  folio                String?  @unique
  fecha                DateTime @default(now())
  estado               String   @default("pendiente")
  solicitadoPor        String?
  observaciones        String?
  clienteId            Int?
  clienteNombre        String?
  clienteTelefono      String?
  clienteCorreo        String?
  usuarioId            Int?
  bodegaId             Int?
  ubicacion            String?
  totalEstimado        Float    @default(0)
  anticipo             Float    @default(0)
  saldoPendiente       Float    @default(0)
  recargo              Float    @default(0)
  porcentajeRecargo    Float    @default(0)
  envio                Float    @default(0)
  metodoPago           String? // método del anticipo
  postventaId          Int?
  postventaCobro       String?  @default("normal")
  unificadoCorrelativo String?

  cliente        Cliente?                       @relation(fields: [clienteId], references: [id])
  usuario        Usuario?                       @relation(fields: [usuarioId], references: [id])
  bodega         Bodega?                        @relation(fields: [bodegaId], references: [id])
  postventa      CambioDevolucion?              @relation(fields: [postventaId], references: [id])
  detalle        DetallePedidoProduccion[]
  avances        ProduccionAvance[]
  mermas         MermaProduccion[]
  pagos          PagoPedido[]
  ajustesPago    AjustePagoPedido[]
  unificaciones  ProduccionUnificadoPedido[]
  tracking       PedidoTracking?
  autorizaciones PedidoProduccionAutorizacion[]
  ordenesMixtas  OrdenMixta[]

  @@index([postventaId])
  @@index([usuarioId, fecha])
  @@index([unificadoCorrelativo])
}

model PedidoProduccionAutorizacion {
  id                  Int       @id @default(autoincrement())
  estado              String    @default("pendiente")
  comentario          String?   @db.MediumText
  respuestaComentario String?   @db.MediumText
  payload             Json
  solicitadoPorId     Int
  autorizadoPorId     Int?
  pedidoId            Int?
  creadoEn            DateTime  @default(now())
  actualizadoEn       DateTime  @updatedAt
  autorizadoEn        DateTime?

  solicitadoPor Usuario           @relation("PedidoAutorizacionSolicitadoPor", fields: [solicitadoPorId], references: [id])
  autorizadoPor Usuario?          @relation("PedidoAutorizacionAutorizadoPor", fields: [autorizadoPorId], references: [id])
  pedido        PedidoProduccion? @relation(fields: [pedidoId], references: [id])

  @@index([estado, creadoEn])
  @@index([solicitadoPorId, creadoEn])
  @@index([autorizadoPorId, creadoEn])
  @@index([pedidoId])
}

model PedidoTracking {
  id            Int       @id @default(autoincrement())
  pedidoId      Int       @unique
  token         String    @unique
  clienteCorreo String?
  ultimoEstado  String    @default("pedido_ingresado")
  ultimoEnvioEn DateTime?
  creadoEn      DateTime  @default(now())
  actualizadoEn DateTime  @updatedAt

  pedido  PedidoProduccion       @relation(fields: [pedidoId], references: [id])
  eventos PedidoTrackingEvento[]

  @@index([clienteCorreo])
}

model PedidoTrackingEvento {
  id           Int      @id @default(autoincrement())
  trackingId   Int
  estado       String
  titulo       String
  mensaje      String?  @db.MediumText
  creadoEn     DateTime @default(now())
  emailEnviado Boolean  @default(false)

  tracking PedidoTracking @relation(fields: [trackingId], references: [id])

  @@index([trackingId, creadoEn])
}

model DetallePedidoProduccion {
  id                   Int       @id @default(autoincrement())
  pedidoId             Int
  productoId           Int
  cantidad             Int
  precioUnit           Float     @default(0)
  bordado              Float     @default(0)
  bordadoColor         String?
  bordadoTamano        String?
  bordadoPosicion      String?
  bordadoObservaciones String?   @db.MediumText
  bordadoImagenUrl     String?   @db.MediumText
  bordadoEstado        String?
  bordadoFechaEntrega  DateTime?
  estiloEspecial       Boolean   @default(false)
  estiloEspecialMonto  Float     @default(0)
  descuento            Float     @default(0)
  descripcion          String?   @default("") @db.MediumText

  pedido   PedidoProduccion                 @relation(fields: [pedidoId], references: [id])
  producto Producto                         @relation(fields: [productoId], references: [id])
  bordados BordadoDetallePedidoProduccion[]
}

model BordadoDetallePedidoProduccion {
  id            Int       @id @default(autoincrement())
  detalleId     Int
  monto         Float     @default(0)
  color         String?
  tamano        String?
  posicion      String?
  observaciones String?   @db.MediumText
  imagenUrl     String?   @db.MediumText
  estado        String?
  fechaEntrega  DateTime?
  creadoEn      DateTime  @default(now())
  actualizadoEn DateTime  @updatedAt

  detalle DetallePedidoProduccion @relation(fields: [detalleId], references: [id])

  @@index([detalleId])
  @@index([estado])
}

model PagoPedido {
  id                  Int      @id @default(autoincrement())
  pedidoId            Int
  monto               Float
  metodo              String
  tipo                String   @default("anticipo") // anticipo o saldo
  fecha               DateTime @default(now())
  recargo             Float    @default(0)
  porcentajeRecargo   Float    @default(0)
  referencia          String?
  banco               String?
  ubicacion           String?
  numeroEnvio         String?
  numeroRecibo        String?
  referenciaDocumento String?
  observacionesPago   String?  @db.MediumText

  pedido PedidoProduccion @relation(fields: [pedidoId], references: [id])
  ajustesComoOriginal AjustePagoPedido[] @relation("AjustePagoOriginal")
  ajusteGenerado AjustePagoPedido? @relation("AjustePagoGenerado")
}

model AjustePagoPedido {
  id                         Int       @id @default(autoincrement())
  folio                      String    @unique
  requestId                  String    @unique
  pedidoId                   Int
  pagoOriginalId             Int
  pagoGeneradoId             Int?      @unique
  cierreOriginalId           Int?
  cierreRectificadoId        Int?
  montoRegistrado            Float
  montoCorrecto              Float
  diferencia                 Float
  fechaPagoReal              DateTime
  metodo                     String
  referencia                 String?
  banco                      String?
  ubicacion                  String?
  motivo                     String    @db.MediumText
  evidenciaReferencia        String    @db.MediumText
  estado                     String    @default("pendiente")
  aprobacionesRequeridas     Int       @default(1)
  solicitadoPorId           Int
  aprobadoPorId              Int?
  segundaAprobacionPorId     Int?
